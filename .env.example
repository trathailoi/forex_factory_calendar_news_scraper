# Docker volume ownership — prevents files in news/ and state/ from becoming root-owned.
# Run `id -u` and `id -g` to get your values.
DOCKER_UID=1000
DOCKER_GID=1000

# Optional runtime overrides:
# FF_RUN_MODE=once
# FF_SCHEDULE_PRESET=weekly
# FF_ALERT_SCHEDULE_PRESET=every_5_minutes
# FF_ALERT_CRON_SCHEDULE=*/5 * * * *

# Connector secrets:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=-1001234567890
# ALERT_WEBHOOK_URL=https://example.com/webhook
# ALERT_WEBHOOK_AUTH=Bearer your-token

# Optional scrape cron override:
# CRON_SCHEDULE=0 6 * * *

# Optional OpenAI key for LLM directional sentiment on alerts.
# Leave OPENAI_API_KEY unset to skip LLM enrichment (math-only sentiment still works).
# OPENAI_MODEL defaults to gpt-4o-mini if unset.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Dashboard API keys:
# Rotate the previously-committed keys before using these.
TD_API_KEY=your_twelvedata_key_here
CMC_API_KEY=your_coinmarketcap_key_here
# Multiple TwelveData keys (different free accounts) for failover, comma-separated.
# Falls back to TD_API_KEY if unset.
# TD_API_KEYS=key1,key2,key3
# Finnhub free key (https://finnhub.io) — fallback for stocks/indices/WTI when TD is exhausted.
# FINNHUB_API_KEY=your_finnhub_key_here
# Optional: override scraper output dir (defaults to ./news)
# FF_OUTPUT_DIR=news
# Host port the dashboard publishes to (docker compose dashboard service; defaults to 8000).
# DASHBOARD_PORT=8000
