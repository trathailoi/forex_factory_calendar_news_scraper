# Force LF on shell scripts + entrypoints so Docker containers (Linux) run them.
# Without this, Windows Git checks out CRLF and the `#!/usr/bin/env bash` shebang
# breaks with: env: 'bash\r': No such file or directory (exit 127).
*.sh            text eol=lf
docker/entrypoint.sh text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf

# Sensible defaults
* text=auto
